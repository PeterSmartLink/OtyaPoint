{
  "name": "omnipoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "check:worker": "tsc --noEmit -p cloudflare-api/tsconfig.json",
    "test:sale-fingerprint": "node --test cloudflare-api/tests/sale-fingerprint.test.mjs",
    "test:sale-route-idempotency": "node --test cloudflare-api/tests/sale-route-idempotency.test.mjs",
    "test:auth-boundary": "node --test cloudflare-api/tests/auth-boundary.test.mjs",
    "test:agency-list": "node --test cloudflare-api/tests/agency-list.test.mjs",
    "test:legacy-products-bridge": "node --test tests/legacy-products-bridge.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "prisma": "^6.2.0",
    "typescript": "^5.7.2"
  }
}
